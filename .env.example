# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Settings (Development - SQLite)
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3

# Database Settings (Production - MariaDB/MySQL)
# DJANGO_DB_ENGINE=django.db.backends.mysql
# DJANGO_DB_NAME=inventory_management
# DJANGO_DB_USER=user
# DJANGO_DB_PASSWORD=password
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=3306

# Environment
DJANGO_ENVIRONMENT=development

# Static Files
DJANGO_STATIC_ROOT=staticfiles
DJANGO_STATIC_URL=/static/

# Media Files
DJANGO_MEDIA_ROOT=media
DJANGO_MEDIA_URL=/media/

# Language and Timezone
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# Security (for production)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True

# Email Settings (optional)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=your-email@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-app-password
# DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost

# MySQL Root Password (for docker-compose)
MYSQL_ROOT_PASSWORD=root_password